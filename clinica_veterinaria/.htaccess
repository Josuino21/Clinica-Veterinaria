Options -Indexes

<FilesMatch "^(?:banco|.*\.sql)$">
    Require all denied
</FilesMatch>

<FilesMatch "^db(?:\.example)?\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
